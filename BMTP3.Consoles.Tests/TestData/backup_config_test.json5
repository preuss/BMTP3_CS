{
  name: 'Pictures backup',
  source: {
    type: 'filesystem',
    path: 'C:\\Users\\John\\Pictures',
    recursive: true,
    includePatterns: ['*.jpg', '*.jpeg', '*.png'],
    excludePatterns: ['*.tmp'],
  },
  destination: {
    path: 'D:\\Backup\\Pictures',
    outputStructure: 'preserve-hierarchy',
    customOutputPattern: '',
  },
  collision: {
    strategy: 'rename',
    comparison: 'size-and-modified-time',
    renameStrategy: 'increment',
    customPattern: '',
  },
  metadata: {
    sidecarFormat: 'ini',
    indexType: 'none',
    comparisonHashAlgorithms: ['sha256'],
    verificationHashAlgorithms: ['sha256'],
    postWriteVerification: 'hash',
    enableTimestampCorrection: true,
  },
  behavior: {
    dryRun: false,
    stopOnError: true,
    delay: 0,
    resumeBehavior: 'continue',
  },
  execution: {},
}
