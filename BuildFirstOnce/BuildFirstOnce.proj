<Project DefaultTargets="RunBumpScript">
  <Target Name="RunBumpScript">
	  <Message Text="Run bump-build.ps1 to bump version..." Importance="high" />
    <Exec Command='powershell -ExecutionPolicy Bypass -File "$(_SolutionDir)bump-build.ps1" -PropsPath "$(_SolutionDir)Directory.Build.props"' />
  </Target>
</Project>
